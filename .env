# Copie para .env e preencha. NUNCA versionar o .env real.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://snct:TROCAR@localhost:5432/snct
SESSION_SECRET=gerar-valor-longo-aleatorio
TZ_OFFSET=-03:00
LOGIN_MAX_ATTEMPTS=5

# Mesmo mecanismo dos demais sistemas da CTI (ver docs/autenticacao.md). ldap | header | dev (dev: só testes, bloqueado em produção)
AUTH_PROVIDER=ldap
LDAP_URL=ldaps://controlador.exemplo.local:636
LDAP_CA_CERT=/etc/ssl/certs/ca-interna.pem
LDAP_BASE_DN=ou=people,dc=exemplo,dc=local
LDAP_BIND_DN=cn=portal-snct,ou=service,dc=exemplo,dc=local
LDAP_BIND_PASSWORD=trocar-aqui
LDAP_USER_FILTER=(uid={prontuario})
LDAP_ATTR_PRONTUARIO=uid
LDAP_ATTR_NOME=displayName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_VINCULO=memberOf
LDAP_GRUPO_SERVIDOR=cn=servidores,ou=groups,dc=exemplo,dc=local
LDAP_GRUPO_ALUNO=cn=alunos,ou=groups,dc=exemplo,dc=local

# Modo header (SSO no proxy)
# AUTH_HEADER_USER=X-Remote-User
# AUTH_TRUSTED_PROXY=127.0.0.1
